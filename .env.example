# ---- Application ----
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---- Telegram ----
# NOTE: the application reads BOT_TOKEN (see application.yml / WebClientConfig).
BOT_TOKEN=your-telegram-bot-token-here
# Only messages from this group/chat id are processed. Leave blank to accept any chat.
TELEGRAM_ALLOWED_GROUP_ID=
# Chat the bot is bound to (optional).
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_PATH=/api/webhook
# Full public URL Telegram should POST updates to (must end with TELEGRAM_WEBHOOK_PATH).
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhook
# Optional shared secret; when set it is registered with Telegram and verified on each update.
TELEGRAM_WEBHOOK_SECRET=

# ---- N8N (geocoding) ----
N8N_URL=http://n8n:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_WEBHOOK_URL=http://localhost:5678

# ---- Admin (Basic auth for /admin/**) ----
ADMIN_USERNAME=admin
# Required — no default in prod. Set a strong value.
ADMIN_PASSWORD=change-me

# ---- Database ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tgbotmap
DB_USERNAME=tgbotmap
DB_PASSWORD=change-me
DB_EXTERNAL_PORT=5432
